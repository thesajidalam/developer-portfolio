generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Portfolio {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  username        String?
  title           String?
  avatarUrl       String?
  portfolioUrl    String
  githubUrl       String?
  socialLinks     String?
  description     String?
  location        String?
  experienceLevel String
  status          String
  health          String
  framework       String?
  language        String?
  hostingProvider String?
  screenshotUrl   String?
  featured        Boolean  @default(false)
  verified        Boolean  @default(false)
  submittedAt     DateTime
  updatedAt       DateTime
  lastChecked     DateTime?

  technologies  PortfolioTechnology[]
  categories    PortfolioCategory[]
  tags          PortfolioTag[]
  score         Score?
  healthChecks  HealthCheck[]
  votes         Vote[]
}

model Technology {
  id   String @id @default(cuid())
  name String
  slug String @unique

  portfolios PortfolioTechnology[]
}

model PortfolioTechnology {
  portfolioId  String
  technologyId String

  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([portfolioId, technologyId])
}

model Category {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  icon        String?
  sortOrder   Int    @default(0)

  portfolios PortfolioCategory[]
}

model PortfolioCategory {
  portfolioId String
  categoryId  String

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([portfolioId, categoryId])
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  portfolios PortfolioTag[]
}

model PortfolioTag {
  portfolioId String
  tagId       String

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([portfolioId, tagId])
}

model Score {
  id                   String   @id @default(cuid())
  portfolioId          String   @unique
  version              String
  performanceScore     Float
  accessibilityScore   Float
  seoScore             Float
  bestPracticesScore   Float
  designScore          Float
  contentScore         Float
  overallScore         Float
  calculatedAt         DateTime

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model HealthCheck {
  id           String    @id @default(cuid())
  portfolioId  String
  checkedAt    DateTime
  statusCode   Int
  responseTime Int
  sslValid     Boolean
  sslExpiry    DateTime?
  accessible   Boolean
  details      String?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Vote {
  id          String   @id @default(cuid())
  portfolioId String
  userId      String
  value       Int
  createdAt   DateTime
  ipHash      String?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Comparison {
  id           String   @id @default(cuid())
  portfolioIds String
  createdAt    DateTime
  viewedAt     DateTime?
}

model Submission {
  id             String    @id @default(cuid())
  portfolioUrl   String
  submitterName  String?
  submitterEmail String?
  status         String
  result         String?
  createdAt      DateTime
  processedAt    DateTime?
}
